# Скопируйте в .env. Файл с реальными секретами не коммитится.

# Локальный RabbitMQ из backend dev Compose. Production использует k8s Secrets.
RABBITMQ_URL=amqp://tramplin:tramplin@localhost:5672/

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
SMTP_FROM_ADDRESS=noreply@tramplin.example
SMTP_TIMEOUT=10.0

# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_TIMEOUT=30.0
