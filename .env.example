# Скопируйте в .env.runtime. Файл с реальными секретами не коммитится.

# Общий RabbitMQ из infra compose (сеть tramplin-edge).
RABBITMQ_USER=tramplin
RABBITMQ_PASSWORD=replace-with-rabbitmq-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
SMTP_FROM_ADDRESS=noreply@tramplin.example
SMTP_TIMEOUT=10.0

# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_TIMEOUT=30.0
